# === Investigador de Prospectos — variables de entorno ===
# Copia este archivo como ".env" y rellena los valores. NUNCA subas el .env real a git.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Opcional, solo para tareas pesadas puntuales:
GEMINI_PRO_MODEL=gemini-1.5-pro

# --- Notion ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Factoria de Landings (Vercel) ---
FACTORIA_BASE_URL=https://plantillas-web-maestra.vercel.app

# --- Scraping ---
# Nicho del dia (editable cada manana o via $env:SEARCH_QUERY inline)
SEARCH_QUERY=gimnasios Lima
LEADS_PER_DAY=10
# Valor que se escribe en la columna multi_select "Nicho" de Notion
NICHO_NOTION=Gym

# --- Perfil de Chrome persistente (cuentas FB/IG ya logueadas) ---
# Reutiliza tu perfil real de Chrome para el fallback FB/IG.
# Cierra Chrome antes de correr (el perfil se bloquea mientras Chrome esta abierto).
CHROME_USER_DATA_DIR=C:\Users\TU_USUARIO\AppData\Local\Google\Chrome\User Data
CHROME_PROFILE_DIRECTORY=Profile 1
